rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function para verificar se a requisição está autenticada
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }


    // Coleção raiz: /connections
    match /connections/{connectionId} {
      // Leitura permitida apenas para o dono da conexão
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Criação permitida garantindo que o userId gravado seja estritamente o do usuário autenticado
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Atualização permitida para o dono, impedindo alteração de propriedade (userId)
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid 
        && request.resource.data.userId == resource.data.userId;
      
      // Exclusão permitida apenas para o dono
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Coleção raiz: /contacts
    match /contacts/{contactId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid 
        && request.resource.data.userId == resource.data.userId;
      
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Coleção raiz: /broadcasts
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid 
        && request.resource.data.userId == resource.data.userId;
      
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Bloqueia qualquer outra rota ou subcoleção não autorizada explicitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
